{
  "name": "test-leak",
  "version": "0.1.0",
  "description": "Detect hanging test leaks like open handles, timers, servers, and child processes.",
  "type": "module",
  "bin": {
    "test-leak": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "test",
    "leak",
    "open-handles",
    "hanging-tests",
    "detect-open-handles",
    "vitest",
    "jest",
    "node-test",
    "testing",
    "ci"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesishandsome/test-leak.git"
  },
  "bugs": {
    "url": "https://github.com/jamesishandsome/test-leak/issues"
  },
  "homepage": "https://github.com/jamesishandsome/test-leak#readme",
  "author": "James <jamesishandsome@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
