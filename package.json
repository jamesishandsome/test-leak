{
  "name": "test-leak",
  "version": "0.1.0",
  "description": "Detect hanging test leaks like timers, open servers, and spawned child processes.",
  "type": "module",
  "bin": {
    "test-leak": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./jest": {
      "types": "./dist/jest.d.ts",
      "import": "./dist/jest.js",
      "require": "./dist/jest.cjs",
      "default": "./dist/jest.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "test",
    "leak",
    "open-handles",
    "hanging-tests",
    "detect-open-handles",
    "vitest",
    "jest",
    "node-test",
    "testing",
    "ci"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesishandsome/test-leak.git"
  },
  "bugs": {
    "url": "https://github.com/jamesishandsome/test-leak/issues"
  },
  "homepage": "https://github.com/jamesishandsome/test-leak#readme",
  "author": "James <jamesishandsome@users.noreply.github.com>",
  "license": "MIT",
  "peerDependencies": {
    "jest": ">=28",
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "jest": "30.4.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
